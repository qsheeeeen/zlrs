diff --git a/drivers/usb/udc/Kconfig.rpi_pico b/drivers/usb/udc/Kconfig.rpi_pico
index fd194520..52f02959 100644
--- a/drivers/usb/udc/Kconfig.rpi_pico
+++ b/drivers/usb/udc/Kconfig.rpi_pico
@@ -25,4 +25,10 @@ config UDC_RPI_PICO_THREAD_PRIORITY
 	help
 	  Device controller driver thread priority.
 
+config UDC_RPI_PICO_THREAD_PREEMPTIBLE
+	bool "Use preemptive scheduling for the UDC controller thread"
+	help
+	  Allow higher priority application threads to preempt controller event handling.
+	  The default preserves cooperative scheduling.
+
 endif # UDC_RPI_PICO
diff --git a/drivers/usb/udc/udc_rpi_pico.c b/drivers/usb/udc/udc_rpi_pico.c
index 83e48760..04a545f9 100644
