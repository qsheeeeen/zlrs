@@ -1152,7 +1152,9 @@ static const struct udc_api udc_rpi_pico_api = {
 				K_THREAD_STACK_SIZEOF(udc_rpi_pico_stack_##n),		\
 				udc_rpi_pico_thread_##n,				\
 				(void *)dev, NULL, NULL,				\
