 *
 * Devicetree overlay for debug builds: enable the console CDC the board keeps disabled
 * (cdc_acm_uart2; chosen `zephyr,console` / `zephyr,shell-uart` already point at it).
 *
 *   west build ... -- -DEXTRA_CONF_FILE=app/debug.conf \
 *                     -DDTC_OVERLAY_FILE=app/debug.overlay
 */

&cdc_acm_uart2 {
	status = "okay";
	/* Queue short replies even before a host opens the console. CDC polling TX
	 * waits for space on longer shell output instead of discarding bytes. */
	tx-fifo-size = <8192>;
	hw-flow-control;
};
