# Application Kconfig entry point.

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

menu "zlrs"


config ZLRS_APP_DEBUG
	bool "Development image (never ship this)"
	help
	  Marks an image built for the bench: it allows the ZLRS_APP_DEBUG_* options below, and
	  nothing that depends on it belongs in a production image. app/debug.conf sets it; the
	  configs that produce shipped images (app/prj.conf, boards/) must not mention it (CI gate).
	  See doc/11-debug.md.

menu "Hardware and product shape"

config ZLRS_APP_RAM_RADIO
	bool "Execute RF application and protocol code from SRAM"
	default y
	depends on SOC_RP2350A_M33
	select CODE_DATA_RELOCATION
	help
	  Keep the RF owner's application, protocol and crypto code in SRAM so external
	  flash instruction fetches do not extend short preparation/completion windows.

config ZLRS_APP_CORE
	def_bool y
	select ZLRS_PROTO
	select ZLRS_LINK
	select ZLRS_REGION
	select ZLRS_MGMT
	help
	  The protocol, data link, region and management modules every image carries. Optional ports
	  and LEDs are described by devicetree (app/src/platform/caps.h); USB is selected by the board.

config ZLRS_APP_ROLE_TX
	bool "Build as the TX role"
	default y
	help
	  The TX initiates pairing and sessions. Both roles send and receive data.


# The only knob on the upgrade path: how long the host has to confirm. The mechanism itself
# (an image under MCUboot stays unconfirmed until the host says so, then either becomes
# permanent or is rolled back) has no switch — the board definition brings the image
# manager and the boot mode with it. See doc/07-firmware.md.
config ZLRS_APP_MCUBOOT_CONFIRM_TIMEOUT_MS
	int "Host confirm timeout (ms)"
	default 60000
	range 0 600000
	depends on BOOTLOADER_MCUBOOT
	help
	  No valid confirm command within this window means a reset and rollback. Leave enough time
	  for USB enumeration plus the tool. 0 = no wait (a host has to confirm immediately).


endmenu

menu "Runtime defaults and link parameters"

config ZLRS_APP_TX_POWER_DBM
	int "TX power (dBm)"
	default 10
	range -10 22

choice ZLRS_APP_SECURITY_PROFILE
	prompt "Over-the-air security profile"
	default ZLRS_APP_SECURITY_PROFILE_P1
	help
	  P1 is the production profile: a 4-byte tag on every frame. P0 carries no tag and is for
	  the bench only. See doc/09-security.md 8.

config ZLRS_APP_SECURITY_PROFILE_P0
	# Selecting P0 is a bench move (no tag at all), so only a debug image may do it.
	bool "P0: no tag (debug image only)" if ZLRS_APP_DEBUG

config ZLRS_APP_SECURITY_PROFILE_P1
	bool "P1: 4-byte tag (default)"

endchoice

config ZLRS_APP_DATA_RATE_BPS
	int "Data link rate (bps)"
	default 2600000

config ZLRS_APP_PACING_SCALE
	int "Superframe pacing scale (bench)"
	default 1
	range 1 8
	help
	  Multiplies the hardware timer superframe period. Both DATA slot boundaries and
	  radio deadlines follow the scaled period; radio work never stretches the schedule.

config ZLRS_APP_PREPARE_US
	int "Preparation time reserved before the next radio slot (us)"
	default 6000 if SPI_PL022_DMA
	default 2800
	range 100 10000
	help
	  Wake before slot 0 and end each radio window early enough to prepare the next slot.
	  Packet construction, authentication, modem setup and FIFO loading run in this window.
	  DMA needs a larger reservation for per-command setup/completion and thread wakeups.

config ZLRS_APP_DATA_24_PREPARE_US
	int "Preparation time for exclusive 2.4 GHz data slots (us)"
	default 1500
	range 100 10000
	help
	  The 2.4 GHz data mode reserves this time for packet construction,
	  authentication and FIFO loading.

config ZLRS_APP_TX_GUARD_US
	int "Time from slot boundary to TX launch (us)"
	default 200
	range 100 10000
	help
	  The radio and FIFO are prepared ahead of the slot boundary. Only SET_TX runs at
	  this fixed offset; receivers enter RX as soon as their preparation is complete.

config ZLRS_APP_FLRC_PREAMBLE_BITS
	int "FLRC preamble length (bits)"
	default 24

config ZLRS_APP_RESYNC_PERIOD_MS
	int "Periodic SYNC interval while connected (ms, 0 = off)"
	default 5000
	range 0 10000
	help
	  Once connected, send a SYNC on the sync channel this often: the peer re-aligns its hop
	  index (crystal drift accumulates into missed hops) and spots a peer reboot or re-pair.
	  See doc/08-protocol.md. Converted to frames, at least one.

config ZLRS_APP_MGMT_TIMEOUT_S
	int "Management mode idle timeout (s)"
	default 300
	help
	  Management mode exits after this long without a command, see doc/07-firmware.md.

config ZLRS_APP_PAIR_HOLD_MS
	int "Hold time needed to start pairing (ms)"
	default 1000
	help
	  The button has exactly one action: holding it this long starts pairing (doc/10-ux.md).
	  There is no press-and-hold-at-boot gesture; management mode comes from the management port.

endmenu

menu "Pending acceptance (see doc/12-roadmap.md)"

config ZLRS_APP_FHSS
	# These features are on in any image that goes on air; a debug image may switch one
	# off to isolate a layer (doc/11-debug.md), a production configuration cannot.
	bool "Per-frame frequency hopping" if ZLRS_APP_DEBUG
	default y
	help
	  With this off every frame stays on the sync channel (entry 0 of the hop table), which is
	  how layer isolation separates timing from the hop table. A fixed channel does not satisfy the
	  FCC 15.247 hopping rules: debug images only, see doc/08-protocol.md.

config ZLRS_APP_SESSION_HANDSHAKE
	bool "Session handshake (fresh key per session)" if ZLRS_APP_DEBUG
	default y
	help
	  Off: the pairing-level link_auth doubles as the session key. The RX counts a SYNC as
	  established and reports back with SESS_RESP, saving a derivation and one confirm message.
	  The cost is no per-session key rotation: recorded frames stay replayable across sessions.
	  Debug images only, see doc/09-security.md 3.

config ZLRS_APP_DATA_ARQ
	bool "Reliable data transfer (ARQ)" if ZLRS_APP_DEBUG
	default y
	help
	  On by default: the receiver flips a header ACK bit for each accepted data packet.
	  The sender waits for that flip before sending the next packet and retransmits on timeout.
	  Off means best-effort (drop when full, count it).
	  See doc/08-protocol.md.

config ZLRS_APP_DYNAMIC_POWER
	bool "Adapt DATA transmit power to quality reported by the peer"
	default y
	help
	  DATA and ACK frames carry the receiver's RSSI and link quality. The transmitter
	  adjusts its own power once per second and returns to the configured ceiling if
	  feedback stops.

config ZLRS_APP_DYNAMIC_POWER_FLOOR_DBM
	int "Dynamic DATA power floor (dBm)"
	default 0
	range -10 22

config ZLRS_APP_WATCHDOG
	bool "Watchdog: reset on a crash or a stuck loop (helps rollback, is not rollback)"
	default n
	depends on WATCHDOG
	help
	  Armed in PRE_KERNEL_1 (app/src/platform/watchdog.c); feeding happens in the blocking
	  loops, so a stuck main loop counts as dead too. It only turns a hang into a reset; the
	  rollback verdict is MCUboot's image confirm bit (doc/07-firmware.md). This saves
	  reaching for BOOTSEL.

config ZLRS_APP_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout (ms)"
	default 8000
	range 100 10000
	depends on ZLRS_APP_WATCHDOG
	help
	  Has to cover the slowest feed interval (PBKDF2 inside management mode) without being too long.


endmenu

menu "Debug image (never in production)"
	depends on ZLRS_APP_DEBUG

config ZLRS_APP_DEBUG_SHELL
	bool "Debug shell on the console CDC"
	default n
	select SHELL
	select SHELL_BACKEND_SERIAL
	help
	  Opens a shell on the console port for basic status, port and recovery commands. Detailed
	  link, rate, radio and power diagnostics are available through the management port in a debug
	  image. Bench debugging only, off in production.

config ZLRS_APP_DEBUG_STATS_LOG
	bool "Status lines once a second on the console (bench debugging)"
	default n
	help
	  A few lines a second: frame counters, air-side failures, data drops, LQ,
	  region and duty. On for the bench, off in production
	  (it is noise). Logging only: the 1 Hz rate and power verdicts are unaffected.

config ZLRS_APP_DEBUG_BOOT_DELAY_MS
	int "Wait after USB comes up before continuing init (ms, 0 = no wait)"
	default 0
	range 0 30000
	help
	  Bench only: give the host time to open the console port (a CDC only transmits once the
	  host has opened it), so a panic during init is actually visible. Keep 0 in production.

config ZLRS_APP_DEBUG_LED_BRIGHTNESS_PERCENT
	int "Status LED brightness (percent)"
	default 10
	range 1 100
	help
	  Scales every status LED frame in a development image. Keep the debug LED dim on the bench;
	  production images use the core LED brightness levels without this debug-only attenuation.


endmenu
endmenu

module = APP
module-str = app
source "subsys/logging/Kconfig.template.log_config"
