# Application Kconfig entry point.

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

menu "zlrs"

config ZLRS_APP_CORE
	def_bool y
	select ZLRS_PROTO
	select ZLRS_LINK
	select ZLRS_REGION
	select ZLRS_CRSF
	help
	  应用永远需要的四层：超帧、配对与会话、法规门、失控值默认值都在里面。
	  库层开关由功能开关反选，避免"库关掉、应用还在调用"的组合。

config ZLRS_APP_ROLE_TX
	bool "构建成 TX 角色"
	default y
	help
	  TX 发控制帧、收遥测，RX 相反。两端是同一份固件，只差这个开关。

config ZLRS_APP_REGION
	int "地区（0 = FCC915，1 = EU868，2 = CN470，3 = CN433）"
	# 默认值按板级变体的 SKU 给：HF 模块跑 868/915，LF 模块跑 470/433。
	# 放在应用侧而不是板级 defconfig 里，是因为 bootloader 镜像也读同一份板级
	# defconfig，而 ZLRS_APP_* 是应用自己的符号（bootloader 里没有它们，
	# Kconfig 会报"给未定义符号赋值"）。
	default 2 if BOARD_RP2350_ZERO_CORE2021_RP2350A_M33_LF
	default 2 if BOARD_RP2350_ZERO_CORE2021_RP2350A_M33_LF_MCUBOOT
	default 0
	range 0 3
	help
	  地区决定控制链路的频段、发射功率上限与占空比上限（见 doc/03-protocol.md
	  5.2 和 lib/region）：EU868 是 1% 占空比，FCC915 / CN470 不限制。
	  HF SKU 只能选 0/1，LF SKU 只能选 2/3——选错的话启动校验会红灯告警并且
	  不发射频（法规相关的不凑合）。

config ZLRS_APP_TX_POWER_DBM
	int "发射功率（dBm）"
	default 10
	range -10 22

choice ZLRS_APP_SECURITY_PROFILE
	prompt "空口安全 profile"
	default ZLRS_APP_SECURITY_PROFILE_P1
	help
	  P1 是生产档：每帧 4 字节 tag。P0 不带 tag，只用于台架——先把收发时序
	  跑通，再打开 tag 看密钥路径。见 doc/02-security.md 第 8 节。

config ZLRS_APP_SECURITY_PROFILE_P0
	bool "P0：不带 tag（仅调试）"

config ZLRS_APP_SECURITY_PROFILE_P1
	bool "P1：4 字节 tag（默认）"

endchoice

config ZLRS_APP_FHSS
	bool "逐包跳频"
	default y
	help
	  关掉以后所有帧都落在同步信道上（跳频表的第 0 个位置），上板调试时先把
	  收发时序与跳频表分开看。固定信道不满足 FCC 15.247 的跳频条款，只能用于
	  台架，见 doc/03-protocol.md 5.2。

config ZLRS_APP_SESSION_HANDSHAKE
	bool "会话三次握手（每次会话换一把钥匙）"
	default y
	help
	  关掉以后直接用配对级的 link_auth 当会话钥匙：RX 收到 BEACON 就算建立，
	  再回 SESS_RESP 报到，少一段钥匙派生、少一条确认消息。代价是没有逐会话的
	  钥匙轮换，录下来的旧帧在换会话后仍能重放——只用于上板调试，
	  见 doc/02-security.md 第 3 节。

config ZLRS_APP_TELEMETRY
	bool "控制链路上行遥测"
	default y
	help
	  关掉以后 RX 不在上行时隙发遥测、TX 也不开那个接收窗口：控制链路退化成
	  "只下行 RC"，适合上板先只验证遥控通道。TX 的失联判定会一并关掉，否则它
	  会因为收不到东西而反复重建会话。

config ZLRS_APP_RESYNC_PERIOD_MS
	int "连接态周期 BEACON 的间隔（毫秒，0 = 关）"
	default 1000
	range 0 10000
	help
	  连上以后每隔这么久用同步信道发一次 BEACON：对端据此校正跳频索引（两端
	  晶振差会累积成"踩空"），也据此发现对端重启或重新配对，自动重新握手。
	  见 doc/03-protocol.md 5.1。间隔按帧数换算，至少 1 帧。

config ZLRS_APP_STATS_LOG
	bool "每秒在控制台打一条链路状态（上板调试用）"
	default n
	help
	  每秒四行收发计数/丢弃/LQ/功率，上板调试开着，量产关掉（噪声）。
	  只影响打不打日志：速率档与动态功率的每秒评估不受影响。

config ZLRS_APP_BOOT_DELAY_MS
	int "USB 起来后、继续初始化之前先等一会儿（毫秒，0 = 不等）"
	default 0
	range 0 30000
	help
	  上板调试用：等一会儿再往下走，好让主机打开控制台端口（CDC 的 TX 要主机
	  打开才收），这样"初始化中途崩了"的 panic 日志才看得到。生产保持 0。

config ZLRS_APP_WATCHDOG
	bool "看门狗：崩溃或卡死自动复位（回滚的助力，不是回滚本身）"
	default n
	depends on WATCHDOG
	help
	  PRE_KERNEL_1 就装好（app/src/watchdog.c），喂狗只在会阻塞的循环里做，
	  "主循环卡住"也算死。它只把卡死变成复位；回滚的判据是镜像确认位
	  （ZLRS_APP_MCUBOOT_CONFIRM），打开它只是省掉"崩了按 BOOTSEL"。

config ZLRS_APP_WATCHDOG_TIMEOUT_MS
	int "看门狗超时（毫秒）"
	default 8000
	range 100 10000
	depends on ZLRS_APP_WATCHDOG
	help
	  要盖住最慢的一次喂狗间隔（配置模式里的 PBKDF2），又不能太长。

config ZLRS_APP_MCUBOOT_CONFIRM
	bool "初始化跑完就确认镜像（配合 MCUboot 的 test/revert 回滚）"
	default y
	depends on BOOTLOADER_MCUBOOT
	# IMG_MANAGER 下面那个 choice 只有一项（MCUBOOT_IMG_MANAGER），
	# 选择项不能 select，所以打开 IMG_MANAGER 就等于选中它
	select STREAM_FLASH
	select IMG_MANAGER
	help
	  初始化跑完就调 boot_write_img_confirmed()。升级走 test 语义，新镜像没跑到
	  这一步就崩的话，复位时 MCUboot 直接回滚（没有上一版就停在串口恢复）。

config ZLRS_APP_MCUBOOT_CONFIRM_MS
	int "初始化完成后还要再跑多久才确认（毫秒，0 = 立刻）"
	default 0
	range 0 600000
	depends on ZLRS_APP_MCUBOOT_CONFIRM
	help
	  0 = 初始化一结束就确认；给一段观察窗口的话，这段时间里崩掉照样回滚。

config ZLRS_APP_USB
	bool "USB 设备栈（三块 CDC：CRSF / 数据口 / 控制台）"
	default y
	select ZLRS_USB
	help
	  用 lib/usb 那份设备栈（应用自己建 context 并注册全部 CDC）。轻量硬件把
	  devicetree 里的 usbd 与别名删掉即可；这里关掉则连设备栈都不建。

config ZLRS_APP_RADIO
	bool "射频（USP/RAC + LR2021）"
	default y
	help
	  关掉后整条射频不参与（走 app/src/radio_null.c），链路状态机与其余功能照常。
	  Core2021 没接时用它验证射频以外的部分：LR20xx 的 HAL 等不到 BUSY 会 k_oops。
	  见 doc/01-system.md 2.3。

config ZLRS_APP_LINK_CONTROL
	bool "控制链路（sub-G：RC + 遥测 + 配对）"
	default y
	help
	  关掉以后只有数据链路在跑：适合先把 2.4G 透传单独调通。注意配对走控制
	  链路，所以关掉它以后只能靠 NVS 里已有的配对记录工作。

config ZLRS_APP_LINK_DATA
	bool "数据链路（2.4G：串口透传）"
	default y
	help
	  关掉以后只有控制链路在跑：适合先把遥控与遥测单独调通。

config ZLRS_APP_CRSF_PORT
	bool "CRSF 端口（手台 ↔ 模块、接收机 → 飞控）"
	default y
	select ZLRS_CRSF
	help
	  关掉以后不初始化 CRSF 端口：TX 一直发配置好的失控值，RX 也不往飞控
	  输出。适合只验证空口、不接手台/飞控的台架。

config ZLRS_APP_CONFIG_MODE
	bool "开机按住按键进配置模式"
	default y
	select ZLRS_CONFIG

config ZLRS_APP_CONFIG_MAGIC
	bool "数据口收到魔数就进配置模式（板上没有用户按键时用）"
	default n
	select ZLRS_CONFIG
	help
	  数据口收到 16 字节 `zlrs!configmode!` 就进配置模式（EXIT/超时回正常），
	  与 `zlrs!bootloader!` 共用一套逐字节匹配（不是魔数的字节原样透传）。

	  给没有用户按键的板子（本板只有 BOOTSEL/RESET）和轻量版 RX 用。

config ZLRS_APP_SHELL
	bool "控制台 CDC 上的调试 shell"
	default n
	select SHELL
	select SHELL_BACKEND_SERIAL
	help
	  在控制台口上开 shell：`zlrs status` / `zlrs ports` / `zlrs config` /
	  `zlrs recovery`。上板调试用，量产关掉。

config ZLRS_APP_PAIRING_BUTTON
	bool "长按按键触发配对"
	default y
	help
	  关掉以后按键只用于开机进配置模式（配对只能从配置工具触发）。

config ZLRS_APP_STATUS_LED
	bool "状态灯"
	default y
	select ZLRS_LED

config ZLRS_APP_UPDATE_TRIGGER
	bool "数据口触发进 MCUboot 串口恢复"
	default y
	depends on BOOTLOADER_MCUBOOT
	select RETENTION
	select RETENTION_BOOT_MODE
	select RETAINED_MEM
	select REBOOT
	help
	  数据口收到 16 字节魔数（`zlrs!bootloader!`）就置 boot mode 并重启：
	  MCUboot 读到这个标志后停在串口恢复，等主机上传签名镜像。这样升级一台
	  健康设备不用拔插 USB 也不用按复位键。见 doc/01-system.md 2.4。

	  魔数是文本串，正常透传数据里几乎不会出现；万一撞上，只有匹配到前缀的那
	  几个字节会被当魔数处理，不会重复投递给上层。量产/竞速构建可以关掉它。

choice ZLRS_APP_BAND_ROLE
	prompt "频段角色"
	default ZLRS_APP_BAND_ROLE_SUBG_CONTROL
	help
	  远距模式（默认）：控制链路占 sub-G（距离），数据链路占 2.4G（吞吐）。
	  竞速模式：对调——控制链路独占 2.4G（短空口时间、高帧率），数据链路让到
	  sub-G 并受地区法规约束（也可以直接关掉数据链路）。见 doc/01-system.md
	  3.2。

config ZLRS_APP_BAND_ROLE_SUBG_CONTROL
	bool "远距模式：控制 sub-G / 数据 2.4G"

config ZLRS_APP_BAND_ROLE_SUBG_DATA
	bool "竞速模式：控制 2.4G / 数据 sub-G"

endchoice

choice ZLRS_APP_CONTROL_MODULATION
	prompt "控制链路调制"
	default ZLRS_APP_CONTROL_MODULATION_FLRC
	depends on ZLRS_APP_BAND_ROLE_SUBG_CONTROL
	help
	  调制按链路各自选（doc/03-protocol.md 4.1.1）：数据链路始终留在 2.4G 跑
	  FLRC，控制链路可以改跑 LoRa 远距档——窄带地区（868/470/433）放不下
	  宽带 FLRC 时就是这条路。超帧周期由最慢的那条链路决定。

config ZLRS_APP_CONTROL_MODULATION_FLRC
	bool "FLRC（宽带，默认）"

config ZLRS_APP_CONTROL_MODULATION_LORA
	bool "LoRa（窄带远距档）"

endchoice

config ZLRS_APP_RACING_CONTROL_RATE_BPS
	int "竞速模式控制链路速率（bps）"
	default 2600000
	depends on ZLRS_APP_BAND_ROLE_SUBG_DATA
	help
	  竞速模式下控制链路独占 2.4G：这里只填 FLRC 的速率档，不受 sub-G 地区
	  的速率上限约束。

config ZLRS_APP_RACING_CONTROL_RATE_HZ
	int "竞速模式控制帧率（Hz）"
	default 500
	range 50 500
	depends on ZLRS_APP_BAND_ROLE_SUBG_DATA
	help
	  2.4G 的帧可以更密（默认 500），但超帧周期仍然要装得下让到 sub-G 的
	  数据链路那两个窗口（见 doc/01-system.md 3.2）。

config ZLRS_APP_LORA_CONTROL_RATE_HZ
	int "LoRa 控制帧率（Hz）"
	default 10
	range 1 50
	depends on ZLRS_APP_CONTROL_MODULATION_LORA
	help
	  LoRa 的一帧就是几十毫秒，10 Hz 已经是"每秒 100 ms"的量级；实际生效值
	  还会被空中时间压档（例如 SF7/BW125、31 B 帧只能到 9 Hz）。

config ZLRS_APP_CONTROL_LORA_SF
	int "LoRa 扩频因子（5–12）"
	default 7
	range 5 12
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_LORA_BW_HZ
	int "LoRa 带宽（Hz：125000 / 250000 / 500000）"
	default 125000
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_LORA_CR
	int "LoRa 编码率（1–4 表示 4/5–4/8）"
	default 1
	range 1 4
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_LORA_PREAMBLE
	int "LoRa 前导码长度（符号数）"
	default 8
	range 4 32
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_RATE_BPS
	int "控制链路速率（bps）"
	default 1300000
	depends on ZLRS_APP_CONTROL_MODULATION_FLRC

config ZLRS_APP_CONTROL_RATE_HZ
	int "控制链路帧率（Hz）"
	default 150
	range 50 500
	depends on ZLRS_APP_CONTROL_MODULATION_FLRC
	help
	  150 = 通用档（远距/默认），500 = 近距离竞速档。
	  500 Hz 时每个时隙只有几百微秒预算，而且只有不限占空比的地区跑得动；
	  实际生效的帧率会被地区占空比压档（见 lib/region 与 doc/03-protocol.md 4.1）。
	  上限 500 是当前架构的限制：RAC 的排期粒度是毫秒，再高要改用 FLRC burst。

config ZLRS_APP_DATA_RATE_BPS
	int "数据链路速率（bps）"
	default 2600000

config ZLRS_APP_DATA_MTU
	int "数据链路单帧载荷上限（字节）"
	default 128

config ZLRS_APP_FLRC_PREAMBLE_BITS
	int "FLRC 前导码长度（bit）"
	default 32

config ZLRS_APP_ROOT_KEY_HEX
	string "根密钥（64 个十六进制字符，空 = 从 NVS 读）"
	default ""

config ZLRS_APP_CRSF_TIMEOUT_MS
	int "TX 收不到 CRSF 输入后转失控值的超时（ms）"
	default 100
	help
	  手台拔线或关机后，TX 在这段时间内没有收到 RC 帧就把空口载荷换成预设
	  失控值。见 doc/01-system.md 2.1。

config ZLRS_APP_TLM_PERIOD_MS
	int "RX 上报遥测的周期（ms）"
	default 100

config ZLRS_APP_CONFIG_TIMEOUT_S
	int "配置模式无操作超时（秒）"
	default 300
	help
	  开机时按住按键进入配置模式；这么久没有命令就退出，见 doc/01-system.md 2.1。

config ZLRS_APP_DATA_ARQ
	bool "透传走 ARQ profile（长度前缀 + 序号 + 累计 ACK + 重传）"
	default n
	help
	  默认是 best-effort：缓冲满就丢，只计数。ARQ 适合不能丢的透传数据，
	  代价是延迟与内存（窗口 4 帧）。见 doc/03-protocol.md 4.3。

config ZLRS_APP_RATE_ADAPT
	bool "按链路质量自动升降速率档"
	default n
	depends on ZLRS_APP_CONTROL_MODULATION_FLRC
	help
	  阈值要按实测曲线标定（见 doc/05-roadmap.md M4），所以默认关着；
	  打开后用 app/src/main.c 里的档位表与滞回参数。

config ZLRS_APP_DYNAMIC_POWER
	bool "按对端回报的信号质量自动升降发射功率"
	default y
	depends on ZLRS_APP_TELEMETRY
	help
	  信号富余就降功率（省电、少干扰），信号吃力就升回来；收不到遥测直接回到
	  上限（那一头多半掉线了）。判据每秒评估一次，阈值与滞回见
	  lib/link/power.c，上板后按实测曲线标定。

config ZLRS_APP_DYNAMIC_POWER_FLOOR_DBM
	int "动态功率的下限（dBm）"
	default 0
	range -10 22
	depends on ZLRS_APP_DYNAMIC_POWER

config ZLRS_APP_PAIR_HOLD_MS
	int "长按配对需要按住的时间（ms）"
	default 1000
	help
	  按键只有这一个动作：按住到这个时长就触发配对（见 doc/06-ui.md）。
	  开机时按住不放则是进配置模式。

endmenu

module = APP
module-str = app
source "subsys/logging/Kconfig.template.log_config"
config ZLRS_APP_ENTROPY_TRNG
	bool "RP2350 硬件 TRNG 当熵源（暂时默认关，见 roadmap）"
	default n
	select ENTROPY_RPI_PICO_RNG
	help
	  默认关：打开后 USB 会死（pico-sdk 的 TRNG 采样是"关中断 + 忙等
	  trng_busy"，USB 得不到服务）。CSPRNG 退到 Zephyr 默认路径，bring-up 够用；
	  量产前必须改成安全取数或换熵源，见 doc/05-roadmap.md 的 M0/M1。
