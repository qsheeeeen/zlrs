# Application Kconfig entry point.

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

menu "zlrs"


config ZLRS_APP_DEBUG
	bool "Development image (never ship this)"
	help
	  Marks an image built for the bench: it allows the ZLRS_APP_DEBUG_* options below, and
	  nothing that depends on it belongs in a production image. app/debug.conf sets it; the
	  configs that produce shipped images (app/prj.conf, boards/) must not mention it (CI gate).
	  See doc/12-debug.md 1.

menu "Hardware and product shape"

config ZLRS_APP_CORE
	def_bool y
	select ZLRS_PROTO
	select ZLRS_LINK
	select ZLRS_REGION
	select ZLRS_CRSF
	select ZLRS_MGMT
	select ZLRS_LED
	help
	  The pure C layers every image carries: framing and hopping, superframe and pairing, the
	  regulatory gate, the CRSF codec, the management protocol and the LED patterns. They have no
	  visible switch; whether there is a port or a LED to use them with comes from devicetree
	  (app/src/platform/caps.h), and USB is selected by the board.

config ZLRS_APP_ROLE_TX
	bool "Build as the TX role"
	default y
	help
	  The TX sends control frames and receives telemetry, the RX does the opposite. Both ends run

config ZLRS_APP_LINK_CONTROL
	bool "Control link (RC + telemetry + pairing)"
	default y
	help
	  Off: only the data link runs, which is how the passthrough gets proven on its own. Pairing
	  happens on the control link, so only an existing NVS pairing record can be used.

config ZLRS_APP_LINK_DATA
	bool "Data link (serial passthrough)"
	default y
	help
	  Off: only the control link runs, which is how RC and telemetry get proven on their own.

# The only knob on the upgrade path: how long the host has to confirm. The mechanism itself
# (an image under MCUboot stays unconfirmed until the host says so, then either becomes
# permanent or is rolled back) has no switch — the board definition brings the image
# manager and the boot mode with it. See doc/08-firmware.md 6.
config ZLRS_APP_MCUBOOT_CONFIRM_TIMEOUT_MS
	int "Host confirm timeout (ms)"
	default 60000
	range 0 600000
	depends on BOOTLOADER_MCUBOOT
	help
	  No valid confirm command within this window means a reset and rollback. Leave enough time
	  for USB enumeration plus the tool. 0 = no wait (a host has to confirm immediately).


endmenu

menu "Runtime defaults and link parameters"

config ZLRS_APP_TX_POWER_DBM
	int "TX power (dBm)"
	default 10
	range -10 22

choice ZLRS_APP_SECURITY_PROFILE
	prompt "Over-the-air security profile"
	default ZLRS_APP_SECURITY_PROFILE_P1
	help
	  P1 is the production profile: a 4-byte tag on every frame. P0 carries no tag and is for
	  the bench only. See doc/10-security.md 8.

config ZLRS_APP_SECURITY_PROFILE_P0
	# Selecting P0 is a bench move (no tag at all), so only a debug image may do it.
	bool "P0: no tag (debug image only)" if ZLRS_APP_DEBUG

config ZLRS_APP_SECURITY_PROFILE_P1
	bool "P1: 4-byte tag (default)"

endchoice

choice ZLRS_APP_BAND_ROLE
	prompt "Band role"
	default ZLRS_APP_BAND_ROLE_SUBG_CONTROL
	help
	  Long-range mode (default): control owns sub-G (distance), data owns 2.4G (throughput).
	  Racing mode swaps them: control takes 2.4G alone (short airtime, high frame rate) and data
	  moves to sub-G under the regional rules (or is turned off). See doc/07-architecture.md 2.

config ZLRS_APP_BAND_ROLE_SUBG_CONTROL
	bool "Long range: control on sub-G, data on 2.4G"

config ZLRS_APP_BAND_ROLE_SUBG_DATA
	bool "Racing: control on 2.4G, data on sub-G"

endchoice

choice ZLRS_APP_CONTROL_MODULATION
	prompt "Control link modulation"
	default ZLRS_APP_CONTROL_MODULATION_FLRC
	depends on ZLRS_APP_BAND_ROLE_SUBG_CONTROL
	help
	  Modulation is per link (doc/07-architecture.md 3): data always runs FLRC on 2.4G, while
	  control can move to the LoRa long-range tier, the way out when the narrow band
	  (868/470/433) cannot fit wide FLRC. The superframe period follows the slower link.

config ZLRS_APP_CONTROL_MODULATION_FLRC
	bool "FLRC (wideband, default)"

config ZLRS_APP_CONTROL_MODULATION_LORA
	bool "LoRa (narrow-band long range)"

endchoice

config ZLRS_APP_RACING_CONTROL_RATE_BPS
	int "Racing mode control rate (bps)"
	default 2600000
	depends on ZLRS_APP_BAND_ROLE_SUBG_DATA
	help
	  In racing mode control owns 2.4G: this is a plain FLRC rate tier, not limited by the
	  sub-G region's rate cap.

config ZLRS_APP_RACING_CONTROL_RATE_HZ
	int "Racing mode control frame rate (Hz)"
	default 500
	range 50 500
	depends on ZLRS_APP_BAND_ROLE_SUBG_DATA
	help
	  2.4G frames can be denser (500 by default), but the superframe still has to fit the two
	  data windows that moved to sub-G (see doc/07-architecture.md 2).

config ZLRS_APP_CONTROL_RATE_BPS
	int "Control link rate (bps)"
	default 1300000
	depends on ZLRS_APP_CONTROL_MODULATION_FLRC

config ZLRS_APP_CONTROL_RATE_HZ
	int "Control link frame rate (Hz)"
	default 150
	range 50 500
	depends on ZLRS_APP_CONTROL_MODULATION_FLRC
	help
	  150 = general tier (long range, default), 500 = close-in racing.
	  At 500 Hz each slot has only a few hundred microseconds and only unlimited-duty regions
	  can sustain it; the effective rate is clamped by the duty cap (core/region, 09-protocol 4.1).
	  The 500 Hz ceiling is architectural: RAC schedules in whole milliseconds, higher needs burst.

config ZLRS_APP_DATA_RATE_BPS
	int "Data link rate (bps)"
	default 2600000

config ZLRS_APP_PACING_SCALE
	int "Superframe pacing scale (bench)"
	default 1
	range 1 8
	help
	  Multiplies the sleep that pads a superframe, without changing the plan the links work
	  from. The radio port costs a couple of milliseconds per transaction (band and PLL
	  reconfiguration), so at a dense plan the loop is work bound: the frame ends up longer
	  than the plan and jitters with whatever each frame had to do, which leaves the two ends
	  free running and keeps the phase lock from ever being able to act. Scaling the pacing
	  leaves the loop idle at the end of the frame, which is exactly the room the lock needs
	  to line the two ends up (doc/12-debug.md 3).

config ZLRS_APP_DIRECT_AT_BOOT
	bool "Data link on the direct FLRC backend from the first frame (bench)"
	default n
	help
	  Debug images only. Puts the data link on the direct driver from the first frame instead of
	  the RAC planner, so the path can be exercised without a console command. The runtime
	  equivalent is `zlrs direct on` (app/src/ports/radio.c).

config ZLRS_APP_BENCH_RAW_MS
	int "Raw radio bench at boot (ms, 0 = off)"
	default 0
	range 0 60000
	help
	  Debug images only. For this long after boot the application skips the superframe and does raw
	  radio work instead: the TX role sends complete frames back to back, the RX role opens 100 ms
	  receive windows back to back, and both log how many frames went out and came in each second.
	  It answers "can these two radios hear each other at all" with no slots, no phases and no ARQ
	  involved — and it needs no console interaction, which matters when a long radio transaction
	  makes the forwarded USB console drop.

config ZLRS_APP_FLRC_PREAMBLE_BITS
	int "FLRC preamble length (bits)"
	default 32

config ZLRS_APP_LORA_CONTROL_RATE_HZ
	int "LoRa control frame rate (Hz)"
	default 10
	range 1 50
	depends on ZLRS_APP_CONTROL_MODULATION_LORA
	help
	  A LoRa frame takes tens of ms, so 10 Hz already means ~100 ms per second on air; the
	  effective value is clamped by airtime (SF7/BW125 with a 31 B frame tops out near 9 Hz).

config ZLRS_APP_CONTROL_LORA_SF
	int "LoRa spreading factor (5-12)"
	default 7
	range 5 12
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_LORA_BW_HZ
	int "LoRa bandwidth (Hz: 125000 / 250000 / 500000)"
	default 125000
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_LORA_CR
	int "LoRa coding rate (1-4 means 4/5-4/8)"
	default 1
	range 1 4
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_CONTROL_LORA_PREAMBLE
	int "LoRa preamble length (symbols)"
	default 8
	range 4 32
	depends on ZLRS_APP_CONTROL_MODULATION_LORA

config ZLRS_APP_TLM_PERIOD_MS
	int "RX telemetry period (ms)"
	default 100

config ZLRS_APP_RESYNC_PERIOD_MS
	int "Periodic SYNC interval while connected (ms, 0 = off)"
	default 5000
	range 0 10000
	help
	  Once connected, send a SYNC on the sync channel this often: the peer re-aligns its hop
	  index (crystal drift accumulates into missed hops) and spots a peer reboot or re-pair.
	  See doc/09-protocol.md 3.6. Converted to frames, at least one.

config ZLRS_APP_CRSF_TIMEOUT_MS
	int "Timeout before the TX switches to failsafe values (ms)"
	default 100
	help
	  With the handset unplugged or powered off, the TX swaps in the preset failsafe payload
	  when no RC frame arrives within this window. See doc/09-protocol.md 3.4.

config ZLRS_APP_MGMT_TIMEOUT_S
	int "Management mode idle timeout (s)"
	default 300
	help
	  Management mode exits after this long without a command, see doc/08-firmware.md 2.

config ZLRS_APP_PAIR_HOLD_MS
	int "Hold time needed to start pairing (ms)"
	default 1000
	help
	  The button has exactly one action: holding it this long starts pairing (doc/11-ux.md).
	  There is no press-and-hold-at-boot gesture; management mode comes from the management port.

config ZLRS_APP_DYNAMIC_POWER_FLOOR_DBM
	int "Dynamic power floor (dBm)"
	default 0
	range -10 22
	depends on ZLRS_APP_DYNAMIC_POWER

endmenu

menu "Pending acceptance (see doc/13-roadmap.md)"

config ZLRS_APP_FHSS
	# These five features are on in any image that goes on air; a debug image may switch one
	# off to isolate a layer (doc/12-debug.md 3), a production configuration cannot.
	bool "Per-frame frequency hopping" if ZLRS_APP_DEBUG
	default y
	help
	  With this off every frame stays on the sync channel (entry 0 of the hop table), which is
	  how layer isolation separates timing from the hop table. A fixed channel does not satisfy the
	  FCC 15.247 hopping rules: debug images only, see doc/09-protocol.md 5.2.

config ZLRS_APP_SESSION_HANDSHAKE
	bool "Session handshake (fresh key per session)" if ZLRS_APP_DEBUG
	default y
	help
	  Off: the pairing-level link_auth doubles as the session key. The RX counts a SYNC as
	  established and reports back with SESS_RESP, saving a derivation and one confirm message.
	  The cost is no per-session key rotation: recorded frames stay replayable across sessions.
	  Debug images only, see doc/10-security.md 3.

config ZLRS_APP_TELEMETRY
	bool "Uplink telemetry on the control link" if ZLRS_APP_DEBUG
	default y
	help
	  Off: the RX sends no telemetry in the uplink slot and the TX opens no receive window, so
	  the control link degrades to downlink RC only, which is how the RC path gets proven
	  first. The TX peer-loss check goes with it, or it would rebuild the session with nothing to hear.

config ZLRS_APP_DATA_ARQ
	bool "Reliable data transfer (ARQ)" if ZLRS_APP_DEBUG
	default y
	help
	  On by default: the receiver acknowledges payloads and the sender retransmits the window
	  until it is acked. Costs latency and RAM; off means best-effort (drop when full, count it).
	  See doc/09-protocol.md 4.3.

config ZLRS_APP_SUB_BAND_MIX
	bool "Sub-band mixing (move slots between 2.4G and sub-G by LQ)" if ZLRS_APP_DEBUG
	default y
	help
	  When LQ drops, telemetry slots move to sub-G first, then the data link, and only then the
	  RC downlink; recovery moves them back in reverse. The duty cap bounds it; see
	  doc/09-protocol.md 5.1.

config ZLRS_APP_RATE_ADAPT
	bool "Adapt the rate tier to link quality"
	default n
	depends on ZLRS_APP_CONTROL_MODULATION_FLRC
	help
	  Thresholds need measured curves (see doc/13-roadmap.md), so this is off by default;
	  turn it on and the tier table and hysteresis in app/src/link/rate.c take over.

config ZLRS_APP_DYNAMIC_POWER
	bool "Adapt TX power to the quality the peer reports"
	default y
	depends on ZLRS_APP_TELEMETRY
	help
	  With signal to spare, drop power (saves energy, less interference); when it gets tight, come
	  back up. Losing telemetry means the ceiling (the other end is probably gone). Applied once a
	  second from app/src/link/power.c; thresholds and hysteresis live in core/link/power.c and
	  wait for measurements.

config ZLRS_APP_WATCHDOG
	bool "Watchdog: reset on a crash or a stuck loop (helps rollback, is not rollback)"
	default n
	depends on WATCHDOG
	help
	  Armed in PRE_KERNEL_1 (app/src/platform/watchdog.c); feeding happens in the blocking
	  loops, so a stuck main loop counts as dead too. It only turns a hang into a reset; the
	  rollback verdict is MCUboot's image confirm bit (doc/08-firmware.md 6). This saves
	  reaching for BOOTSEL.

config ZLRS_APP_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout (ms)"
	default 8000
	range 100 10000
	depends on ZLRS_APP_WATCHDOG
	help
	  Has to cover the slowest feed interval (PBKDF2 inside management mode) without being too long.


endmenu

menu "Debug image (never in production)"
	depends on ZLRS_APP_DEBUG

config ZLRS_APP_DEBUG_SHELL
	bool "Debug shell on the console CDC"
	default n
	select SHELL
	select SHELL_BACKEND_SERIAL
	help
	  Opens a shell on the console port: `zlrs status` / `zlrs ports` / `zlrs config` /
	  `zlrs recovery`. Bench debugging only, off in production.

config ZLRS_APP_DEBUG_STATS_LOG
	bool "Status lines once a second on the console (bench debugging)"
	default n
	help
	  A few lines a second: frame counters, air-side counters and transaction failures, CRSF and
	  data port drops, LQ, region and duty, dynamic power. On for the bench, off in production
	  (it is noise). Logging only: the 1 Hz rate and power verdicts are unaffected.

config ZLRS_APP_DEBUG_BOOT_DELAY_MS
	int "Wait after USB comes up before continuing init (ms, 0 = no wait)"
	default 0
	range 0 30000
	help
	  Bench only: give the host time to open the console port (a CDC only transmits once the
	  host has opened it), so a panic during init is actually visible. Keep 0 in production.

config ZLRS_APP_DEBUG_LED_BRIGHTNESS_PERCENT
	int "Status LED brightness (percent)"
	default 20
	range 1 100
	help
	  Scales every status LED frame in a development image. Keep the debug LED dim on the bench;
	  production images use the core LED brightness levels without this debug-only attenuation.


endmenu
endmenu

