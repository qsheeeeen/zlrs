 * Copyright (c) 2026 zlrs contributors
 *
 * SPDX-License-Identifier: Apache-2.0
 *
 * Devicetree overlay for the mcuboot image only (sysbuild picks up app/sysbuild/<image>.overlay).
 *
 * The application has three CDCs (CRSF, data, config); the bootloader keeps two:
 *   - cdc_acm_uart1 = data port -> serial recovery (mcumgr frames; `zephyr,uart-mcumgr`
 *     points at it in the board dts)
 *   - cdc_acm_uart3 = console -> kernel log (disabled by default, enabled here)
 *   - cdc_acm_uart0 (CRSF) and cdc_acm_uart2 (config) are useless in the bootloader and get
 *     deleted, along with the CRSF alias, or dtc complains about the dangling reference
 * In upgrade mode the host then sees two MCUBOOT ports: recovery first, log second.
 *
 * This overlay also has to set `zephyr,code-partition = &boot_partition` itself: Zephyr only
 * falls back to MCUboot's own bootloader/mcuboot/boot/zephyr/app.overlay when there is *no*
 * DTC_OVERLAY_FILE, and that file holds this single line (the bootloader must link against the
 * mcuboot partition at 0x0, not slot0). Bring it along when providing your own overlay.
 */

/ {
	aliases {
		/delete-property/ zlrs-control-cdc;
		/delete-property/ zlrs-config-cdc;
		/* zlrs-data-cdc points at the CDC used for recovery, keep it */
	};

	chosen {
		zephyr,code-partition = &boot_partition;
	};
};

&usbd {
	/delete-node/ cdc_acm_uart0;
	/delete-node/ cdc_acm_uart2;
};

&cdc_acm_uart3 {
	status = "okay";
};
