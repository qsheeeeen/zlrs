menu "zlrs RP2350 TRNG"

config ZLRS_RP2350_TRNG
	bool "zlrs RP2350 TRNG entropy driver"
	default y
	# Only built into images with the entropy subsystem (the bootloader has no ENTROPY_GENERATOR)
	depends on DT_HAS_ZLRS_RP2350_TRNG_ENABLED && ENTROPY_GENERATOR
	select ENTROPY_HAS_DRIVER
	help
	  Drives the TRNG registers directly per RP2350 datasheet 12.12: 6 EHR words per 192-bit
	  block, reads fresh complete blocks with bounded waits and interrupts left enabled.
	  Zephyr's entropy_rpi_pico goes through pico-sdk get_rand_64(), which spins with interrupts
	  off and kills USB, so it is not used here. See doc/08-security.md#entropy-contract.

if ZLRS_RP2350_TRNG

module = ZLRS_TRNG
module-str = zlrs_trng
source "subsys/logging/Kconfig.template.log_config"

endif # ZLRS_RP2350_TRNG

endmenu
