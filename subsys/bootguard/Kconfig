# The SoC compiles a ROM-bootloader jump hook into every image by default (it jumps into the
# ROM mass-storage mode when it sees the boot-mode flag); inside the bootloader image it runs
# before MCUboot's serial recovery. The application keeps it as a bricked-device escape hatch.
config RPI_PICO_ROM_BOOTLOADER
	default n if IS_BOOTLOADER

config ZLRS_BOOTGUARD
	bool "Boot guard in the bootloader (disarm the watchdog first)"
	default y if IS_BOOTLOADER
	depends on WATCHDOG
	help
	  MCUboot disarms the watchdog first: on RP2350 it can still be armed after a reset and would
	  cut a swap or rollback short. The application decides whether to arm it again (ZLRS_APP_WATCHDOG).

module = ZLRS_BOOTGUARD
module-str = zlrs_bootguard
source "subsys/logging/Kconfig.template.log_config"
