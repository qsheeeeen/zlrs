 *
 * 带 MCUboot 的 HF 变体（868 / 915）。组合顺序：
 * 1. SoC 公共部分（rp2350a）  2. 核相关部分（Cortex-M33）
 * 3. 板级公共部分  4. HF SKU 的 sub-G 标定
 * 5. MCUboot 分区表（见同目录 README 与 partitions_mcuboot.dtsi）
 */

/dts-v1/;

#include <raspberrypi/rpi_pico/rp2350a.dtsi>
#include <raspberrypi/rpi_pico/m33.dtsi>

#include "rp2350_zero_core2021.dtsi"
#include "rp2350_zero_core2021_hf.dtsi"

/* 分区：mcuboot 128 KB / slot0 832 KB / slot1 832 KB / storage 2.25 MB */
#include "rp2350_zero_core2021_partitions_mcuboot.dtsi"

/* 应用侧"进串口恢复"用的 boot mode 区：Zephyr 树里 RP2350 专用的小覆盖，
 * 在 SRAM 起始处留 4 字节并把 sram0 让开（见 doc/08-firmware.md 第 5 节） */
#include <vendor/raspberrypi/rp2350-boot-mode-retention.dtsi>

/ {
	chosen {
		/* 应用链接进 slot0：MCUboot 校验通过后从这里启动 */
		zephyr,code-partition = &slot0_partition;
		/*
		 * MCUboot 的串口恢复只走 USB：指向数据口那块 CDC
		 * （`cdc_acm_uart1`，板载 USB-C 枚举出来的第二个口）。插一根 USB 线
		 * 就能升级，不需要 UART 转接板；GP8/GP9 那路 UART 仍然留给应用。
		 */
		zephyr,uart-mcumgr = &cdc_acm_uart1;
	};
};
