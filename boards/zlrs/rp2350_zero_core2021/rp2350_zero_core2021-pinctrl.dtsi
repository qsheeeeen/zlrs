#include <zephyr/dt-bindings/pinctrl/rpi-pico-pinctrl-common.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>

&pinctrl {
	/* CRSF: the pair that is Pico's default on the RP2350-Zero, wired to handset or FC */
	uart0_default: uart0_default {
		group1 {
			pinmux = <UART0_TX_P0>;
		};

		group2 {
			pinmux = <UART0_RX_P1>;
			input-enable;
			/* Unconnected RX must idle high: a floating pin produces phantom bytes,
			 * and one phantom byte is enough to make the port layer pick this UART
			 * over the USB CDC (app/src/ports.c, host_seen_any). */
			bias-pull-up;
		};
	};

	/* Radio SPI0: stays clear of GP16, the on-board WS2812B data pin */
	zlrs_spi0_default: zlrs_spi0_default {
		group1 {
			pinmux = <SPI0_SCK_P6>, <SPI0_TX_P7>;
		};

		group2 {
			pinmux = <SPI0_RX_P4>;
			input-enable;
		};
	};

	/* Data UART: the passthrough port */
	zlrs_uart1_default: zlrs_uart1_default {
		group1 {
			pinmux = <UART1_TX_P8>;
		};

		group2 {
			pinmux = <UART1_RX_P9>;
			input-enable;
			/* Same as the CRSF UART: idle high when nothing is attached */
			bias-pull-up;
		};
	};

	/* The on-board WS2812B data pin (GP16) goes to PIO0, wired as on the upstream waveshare board */
	ws2812_pio0_default: ws2812_pio0_default {
		ws2812 {
			pinmux = <PIO0_P16>;
		};
	};
};
