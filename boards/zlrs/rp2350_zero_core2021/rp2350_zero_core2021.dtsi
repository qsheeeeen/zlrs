/*
 * Board definition for the Waveshare RP2350-Zero (RP2350A, 4 MB flash) plus the Waveshare
 * Core2021 (LR2021). Wiring and part choices: README.md in this directory.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <freq.h>

#include <zephyr/dt-bindings/dma/rpi-pico-dma-rp2350.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/led/led.h>

#include "rp2350_zero_core2021-pinctrl.dtsi"

/ {
	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,flash-controller = &qmi;
		/* Console off by default: it only exists once the debug overlay enables cdc_acm_uart3 */
		zephyr,console = &cdc_acm_uart3;
		zephyr,shell-uart = &cdc_acm_uart3;
		zephyr,lorawan-transceiver = &lora_core2021;
		/* Entropy comes from the zlrs TRNG driver (bounded waits, no interrupt masking; drivers/entropy) */
		zephyr,entropy = &rng;
		/* Each variant sets zephyr,code-partition itself: code without a bootloader, slot0 with one
		 * (see the partition table in this directory's README) */
	};
	aliases {
		lora-transceiver = &lora_core2021;
		zlrs-control-uart = &uart0;
		zlrs-data-uart = &uart1;
		zlrs-control-cdc = &cdc_acm_uart0;
		zlrs-data-cdc = &cdc_acm_uart1;
		zlrs-mgmt-cdc = &cdc_acm_uart2;
		zlrs-button = &zlrs_button;
		zlrs-led = &zlrs_led;
		led-strip = &zlrs_led;
		watchdog0 = &wdt0;
		zlrs-slot-timer = &timer1;
		/* The vendor USP samples (packet_error_rate_flrc and friends) expect this alias */
		smtc-user-button = &zlrs_button;
	};

	buttons {
		compatible = "gpio-keys";

		zlrs_button: zlrs-button {
			gpios = <&gpio0 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};

};

/*
 * RP2350 TRNG: the SoC's rng@400f0000 node (reg gives the block base) is switched to the zlrs
 * driver. The one in the Zephyr tree that binds `raspberrypi,pico-rng` goes through pico-sdk's
 * interrupt-off busy wait and stops USB, see the header of drivers/entropy/rp2350_trng.c.
 */
&rng {
	compatible = "zlrs,rp2350-trng";
	status = "okay";
};

&gpio0 {
	status = "okay";
};

/*
 * Hardware watchdog (RP2350 wdt0): armed when the application starts and fed from the main
 * loop. A crash or a stuck thread resets the chip, which MCUboot's test/revert turns into a
 * rollback, and with nothing left to boot it stops in serial recovery: no BOOTSEL needed.
 * See doc/08-firmware.md 6.
 */
&wdt0 {
	status = "okay";
};

/* CRSF: GP0 = TX / GP1 = RX, to the handset or flight controller; 420000 is CRSF's baud rate */
&uart0 {
	status = "okay";
	current-speed = <420000>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/* Data port: passthrough, GP8 = TX / GP9 = RX */
&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&zlrs_uart1_default>;
	pinctrl-names = "default";
};

/* RP2350 hardware TRNG feeding the CSPRNG */
&rng {
	status = "okay";
};

/* DMA channels: SPI0 TX/RX = 0/1, status LED TX = 2. */
&dma {
	status = "okay";
};

/*
 * The on-board WS2812B (GP16, one pixel) is the status LED, see doc/11-ux.md: driven through
 * PIO0, wired the same way as upstream waveshare/rp2350_zero.
 */
&pio0 {
	status = "okay";

	pio-ws2812 {
		compatible = "worldsemi,ws2812-rpi_pico-pio";
		status = "okay";
		pinctrl-0 = <&ws2812_pio0_default>;
		pinctrl-names = "default";
		bit-waveform = <3>, <3>, <4>;

		zlrs_led: ws2812 {
			status = "okay";
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			chain-length = <1>;
			dmas = <&dma 2 RPI_PICO_DMA_SLOT_PIO0_TX0 0>;
			dma-names = "tx";
			/*
			 * The WS2812B's physical byte order is GRB, so declare it the way the part expects, or red and
			 * green swap (measured: red shows green, blue shows purple). Upstream waveshare rp2350_zero
			 * writes RGB and falls into the same trap.
			 */
			color-mapping = <LED_COLOR_ID_GREEN
					 LED_COLOR_ID_RED
					 LED_COLOR_ID_BLUE>;
			reset-delay = <280>;
			frequency = <DT_FREQ_K(800)>;
		};
	};
};

/*
 * The CDCs on USB (doc/08-firmware.md 1):
 *   cdc_acm_uart0 = CRSF (alias zlrs-control-cdc)
 *   cdc_acm_uart1 = data port (alias zlrs-data-cdc)
 *   cdc_acm_uart2 = management port (alias zlrs-mgmt-cdc): management protocol, enter management mode
 *   cdc_acm_uart3 = console (kernel log + shell): off by default, the debug overlay enables it
 *
 * The first two are the links' USB endpoints and compete with their UARTs (app/src/ports/serial.c);
 * the management port and console exist on USB only.
 */
zephyr_udc0: &usbd {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "zlrs CONTROL";
	};

	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		label = "zlrs DATA";
	};

	cdc_acm_uart2: cdc_acm_uart2 {
		compatible = "zephyr,cdc-acm-uart";
		label = "zlrs CONFIG";
	};

	cdc_acm_uart3: cdc_acm_uart3 {
		compatible = "zephyr,cdc-acm-uart";
		label = "zlrs CONSOLE";
		status = "disabled";
	};
};

/* 4 MB QSPI flash. The layout is not in the common dtsi: each variant's dts includes
 * rp2350_zero_core2021_partitions.dtsi, which is the flash map the application and the bootloader
 * are both built with (see the README). */
&flash0 {
	reg = <0x10000000 DT_SIZE_M(4)>;
};

&spi0 {
	status = "okay";
	dmas = <&dma 0 RPI_PICO_DMA_SLOT_SPI0_TX 0>,
	       <&dma 1 RPI_PICO_DMA_SLOT_SPI0_RX 0>;
	dma-names = "tx", "rx";
	clock-frequency = <DT_FREQ_M(8)>;
	pinctrl-0 = <&zlrs_spi0_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;

	lora_core2021: lora@0 {
		reg = <0>;
		compatible = "semtech,lr2021";
		spi-max-frequency = <DT_FREQ_M(16)>;

		// Board-specific offset
		tx-power-offset = <0>;

		// RX boost offset, from 0 (no RX boost) to 7 (max RX boost)
		rx-boost-cfg = <7>;

		/* Control lines sit on GP13-GP15: GP16 drives the on-board WS2812 and wiring above it is awkward */
		reset-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>; // NRESET

		busy-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // BUSY

		reg-mode = <0x02 /* LR20XX_REG_MODE_DCDC */>;

		lf-clk = <0x00 /* LR20XX_SYSTEM_LFCLK_RC */>;

		/*
		 * 0 = the driver leaves the radio in XTAL mode, which is what the vendor's own LR20xx boards
		 * use. A real TCXO wakeup time here is not free: the RAC sleeps the radio between
		 * transactions, so every transaction would wait out the TCXO startup, and at a millisecond
		 * slot budget that aborts every send (measured: the link stopped transmitting entirely).
		 */
		tcxo-voltage = <0x02 /* LR20XX_SYSTEM_TCXO_CTRL_1_8V */>;
		tcxo-wakeup-time = <0>;

		// Radio output power setting tables
		/* half_power, pa_lf_duty_cycle, pa_lf_slices */



		tx-power-cfg-hf =
		/* half_power, pa_duty_cycle, pa_hp_sel */
		/* meas @2445MHz */
		<(-39) 29   0x07>, /* Expected output power = -17dBm */
		<(-39) 16   0x07>, /* Expected output power = -16dBm */
		<(-35) 19   0x07>, /* Expected output power = -15dBm */
		<(-32) 19   0x07>, /* Expected output power = -14dBm */
		<(-29) 19   0x07>, /* Expected output power = -13dBm */
		<(-27) 16   0x07>, /* Expected output power = -12dBm */
		<(-24) 17   0x07>, /* Expected output power = -11dBm */
		<(-22) 16   0x07>, /* Expected output power = -10dBm */
		<(-19) 18   0x07>, /* Expected output power = -9dBm */
		<(-17) 16   0x07>, /* Expected output power = -8dBm */
		<(-14) 21   0x07>, /* Expected output power = -7dBm */
		<(-12) 18   0x07>, /* Expected output power = -6dBm */
		<( -7) 30   0x07>, /* Expected output power = -5dBm */
		<( -8) 16   0x07>, /* Expected output power = -4dBm */
		<( -5) 24   0x07>, /* Expected output power = -3dBm */
		<( -2) 27   0x07>, /* Expected output power = -2dBm */
		<(  1) 29   0x07>, /* Expected output power = -1dBm */
		<(  4) 30   0x07>, /* Expected output power = 0dBm */
		<(  6) 30   0x07>, /* Expected output power = 1dBm */
		<(  7) 28   0x07>, /* Expected output power = 2dBm */
		<(  8) 25   0x07>, /* Expected output power = 3dBm */
		<( 10) 25   0x07>, /* Expected output power = 4dBm */
		<( 15) 31   0x07>, /* Expected output power = 5dBm */
		<( 16) 30   0x07>, /* Expected output power = 6dBm */
		<( 18) 30   0x07>, /* Expected output power = 7dBm */
		<( 21) 31   0x07>, /* Expected output power = 8dBm */
		<( 22) 30   0x07>, /* Expected output power = 9dBm */
		<( 24) 30   0x07>, /* Expected output power = 10dBm */
		<( 24) 26   0x07>, /* Expected output power = 11dBm */
		<( 24) 16   0x07>; /* Expected output power = 12dBm */

		// Power consumptions tables
		// DC/DC mode, LF path



		// LDO mode, LF path, NOT MEASed
		tx-dbm-to-ua-reg-mode-ldo-lf-vreg = <
		1000  /* -10 dBm */
		1000  /*  -9 dBm */
		1000  /*  -8 dBm */
		1000  /*  -7 dBm */
		1000  /*  -6 dBm */
		1000  /*  -5 dBm */
		1000  /*  -4 dBm */
		1000  /*  -3 dBm */
		1000  /*  -2 dBm */
		1000  /*  -1 dBm */
		1000  /*   0 dBm */
		1000  /*   1 dBm */
		1000  /*   2 dBm */
		1000  /*   3 dBm */
		1000  /*   4 dBm */
		1000  /*   5 dBm */
		1000  /*   6 dBm */
		1000  /*   7 dBm */
		1000  /*   8 dBm */
		1000  /*   9 dBm */
		1000  /*  10 dBm */
		1000  /*  11 dBm */
		1000  /*  12 dBm */
		1000  /*  13 dBm */
		1000  /*  14 dBm */
		1000  /*  15 dBm */
		1000  /*  16 dBm */
		1000  /*  17 dBm */
		1000  /*  18 dBm */
		1000  /*  19 dBm */
		1000  /*  20 dBm */
		1000  /*  21 dBm */
		1000  /*  22 dBm */
		>;

		// DC/DC mode, HF path, meas @2445MHz
		tx-dbm-to-ua-reg-mode-dcdc-hf-vreg = <
		8625   /* -17 dBm */
		8783   /* -16 dBm */
		8874   /* -15 dBm */
		8998   /* -14 dBm */
		9145   /* -13 dBm */
		9289   /* -12 dBm */
		9481   /* -11 dBm */
		9646   /* -10 dBm */
		9840   /* -9 dBm */
		10073  /* -8 dBm */
		10280  /* -7 dBm */
		10597  /* -6 dBm */
		10511  /* -5 dBm */
		11200  /* -4 dBm */
		11391  /* -3 dBm */
		11630  /* -2 dBm */
		11360  /* -1 dBm */
		11635  /*  0 dBm */
		11986  /*  1 dBm */
		12670  /*  2 dBm */
		13292  /*  3 dBm */
		13859  /*  4 dBm */
		13685  /*  5 dBm */
		14629  /*  6 dBm */
		15388  /*  7 dBm */
		15804  /*  8 dBm */
		17270  /*  9 dBm */
		18943  /* 10 dBm */
		21041  /* 11 dBm */
		22524  /* 12 dBm */
		>;

		// RX LoRa tables
		// Measured @LR20XX_RADIO_COMMON_RX_PATH_BOOST_MODE_NONE
		rx-bw-to-ua-reg-mode-dcdc-lf-vreg = <
		5700  /* RAL_LORA_BW_125_KHZ */
		5790  /* RAL_LORA_BW_250_KHZ */
		6320  /* RAL_LORA_BW_400_KHZ */
		6140  /* RAL_LORA_BW_500_KHZ */
		6840  /* RAL_LORA_BW_800_KHZ */
		6600  /* RAL_LORA_BW_1000_KHZ */
		>;

		rx-bw-to-ua-reg-mode-dcdc-hf-vreg = <
		6400  /* RAL_LORA_BW_125_KHZ */
		6510  /* RAL_LORA_BW_250_KHZ */
		7040  /* RAL_LORA_BW_400_KHZ */
		6860  /* RAL_LORA_BW_500_KHZ */
		6880  /* RAL_LORA_BW_800_KHZ */
		7350  /* RAL_LORA_BW_1000_KHZ */
		>;

		// Measured @LR20XX_RADIO_COMMON_RX_PATH_BOOST_MODE_7
		rx-bw-to-ua-reg-mode-dcdc-lf-vreg-boosted = <
		6920  /* RAL_LORA_BW_125_KHZ */
		6990  /* RAL_LORA_BW_250_KHZ */
		7530  /* RAL_LORA_BW_400_KHZ */
		7370  /* RAL_LORA_BW_500_KHZ */
		8160  /* RAL_LORA_BW_800_KHZ */
		7820  /* RAL_LORA_BW_1000_KHZ */
		>;

		rx-bw-to-ua-reg-mode-dcdc-hf-vreg-boosted = <
		6740  /* RAL_LORA_BW_125_KHZ */
		6850  /* RAL_LORA_BW_250_KHZ */
		7130  /* RAL_LORA_BW_400_KHZ */
		7180  /* RAL_LORA_BW_500_KHZ */
		8010  /* RAL_LORA_BW_800_KHZ */
		7690  /* RAL_LORA_BW_1000_KHZ */
		>;

		rx-bw-to-ua-reg-mode-ldo-lf-vreg = <
		9420   /* RAL_LORA_BW_125_KHZ */
		9580   /* RAL_LORA_BW_250_KHZ */
		10580  /* RAL_LORA_BW_400_KHZ */
		10240  /* RAL_LORA_BW_500_KHZ */
		11770  /* RAL_LORA_BW_800_KHZ */
		11130  /* RAL_LORA_BW_1000_KHZ */
		>;

		rx-bw-to-ua-reg-mode-ldo-hf-vreg = <
		10760  /* RAL_LORA_BW_125_KHZ */
		10890  /* RAL_LORA_BW_250_KHZ */
		11870  /* RAL_LORA_BW_400_KHZ */
		11640  /* RAL_LORA_BW_500_KHZ */
		13130  /* RAL_LORA_BW_800_KHZ */
		12500  /* RAL_LORA_BW_1000_KHZ */
		>;

		rx-bw-to-ua-reg-mode-ldo-lf-vreg-boosted = <
		11670  /* RAL_LORA_BW_125_KHZ */
		11710  /* RAL_LORA_BW_250_KHZ */
		12880  /* RAL_LORA_BW_400_KHZ */
		12560  /* RAL_LORA_BW_500_KHZ */
		14090  /* RAL_LORA_BW_800_KHZ */
		13500  /* RAL_LORA_BW_1000_KHZ */
		>;

		rx-bw-to-ua-reg-mode-ldo-hf-vreg-boosted = <
		11410  /* RAL_LORA_BW_125_KHZ */
		11570  /* RAL_LORA_BW_250_KHZ */
		12590  /* RAL_LORA_BW_400_KHZ */
		12280  /* RAL_LORA_BW_500_KHZ */
		13720  /* RAL_LORA_BW_800_KHZ */
		13180  /* RAL_LORA_BW_1000_KHZ */
		>;


		dios {
			compatible = "semtech,lr20xx-dios";
			#address-cells = <1>;
			#size-cells = <0>;
			dio@8 {
				reg = <8>;
				function = <0x01 /* LR20XX_SYSTEM_DIO_FUNC_IRQ */>;
				dio-gpios = <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // DIO8
				irq-mask = <0xffff07ff /* LR20XX_SYSTEM_IRQ_ALL_MASK */>;
			};
		};
	};
};

/* TIMER1 is dedicated to radio slot boundaries; SysTick remains the kernel clock. */
&timer1 {
	interrupts = <4 0>, <5 0>, <6 0>, <7 0>;
	compatible = "zlrs,rp2350-slot-timer";
	status = "okay";
};

/* Timestamp radio GPIO events ahead of USB traffic. */
&gpio0_map {
	interrupts = <21 1>;
};
