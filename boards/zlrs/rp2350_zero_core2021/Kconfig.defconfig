#
# 板级公共默认值：三个目标（不带变体 / hf / lf）都适用，各变体的 _defconfig
# 里只放自己那点差异（目前就是地区默认值）。

if BOARD_RP2350_ZERO_CORE2021

config BUILD_OUTPUT_HEX
	default y

config BUILD_OUTPUT_UF2
	default y

config CLOCK_CONTROL
	default y

config CONSOLE
	default y

config GPIO
	default y

config RESET
	default y

config SERIAL
	default y

config UART_CONSOLE
	default y

# 控制台挂在 USB 的第三个 CDC 上（见 rp2350_zero_core2021.dtsi 的 chosen），
# 所以板级默认把 USB 设备栈与 CDC ACM 类打开。
#
# 注意这里不给 CDC_ACM_SERIAL_INITIALIZE_AT_BOOT 默认值：那个辅助实现只注册
# 第一块 CDC，应用侧要用 ZLRS_APP_USB（app/src/usb_dev.c）自己建 context 并
# 注册全部三块；bootloader 另算——它只有两块 CDC，且 app/sysbuild/mcuboot.conf
# 里自己把这个开关打开（见 doc/02-platform.md 第 5 节）。
config USB_DEVICE_STACK_NEXT
	default y

config USBD_CDC_ACM_CLASS
	default y

config UART_LINE_CTRL
	default y

config UART_INTERRUPT_DRIVEN
	default y

# 链接进 devicetree 里的 code 分区（1 MB），见 rp2350_zero_core2021.dtsi：
# 镜像不能长过它，否则会压掉后面存密钥的 storage 分区
config USE_DT_CODE_PARTITION
	default y

endif # BOARD_RP2350_ZERO_CORE2021
