#
# Board-wide defaults, shared by every target (bare, hf, lf); each variant's _defconfig
# only carries its own difference, which today is the default region.

if BOARD_RP2350_ZERO_CORE2021

config BUILD_OUTPUT_HEX
	default y

config BUILD_OUTPUT_UF2
	default y

config CLOCK_CONTROL
	default y

config GPIO
	default y

config RESET
	default y

config SERIAL
	default y

# No console by default (cdc_acm_uart3 is disabled; chosen points at it but only the debug
# overlay enables it), so the board sets no CONSOLE / UART_CONSOLE default. Debug builds get
# it from app/debug.conf + app/debug.overlay (docs/design/12-debug.md 1).
#
# USB device stack and CDC ACM class on by default: three CDCs in the application (CRSF,
# data, config) and two in the bootloader (recovery, console).
#
# Note there is no default for CDC_ACM_SERIAL_INITIALIZE_AT_BOOT: that helper registers
# only the first CDC, while subsys/usb builds its own context and registers them all.
config USB_DEVICE_STACK_NEXT
	default y

config USBD_CDC_ACM_CLASS
	default y

config UART_LINE_CTRL
	default y

config UART_INTERRUPT_DRIVEN
	default y

# Link into the devicetree code partition (1 MB), see rp2350_zero_core2021.dtsi: the image
# must not outgrow it or it would run into the storage partition that holds the keys
config USE_DT_CODE_PARTITION
	default y

endif # BOARD_RP2350_ZERO_CORE2021
