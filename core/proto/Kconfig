config ZLRS_PROTO
	bool "Protocol core (framing, FHSS sequence, reassembly, CRC)"
	help
	  Pure C framing and protocol crypto, without a Zephyr dependency. HMAC, HKDF
	  and PBKDF2 use the SHA-256 operation supplied by the application. Host tests
	  can supply a software SHA-256 implementation.

module = ZLRS_PROTO
module-str = zlrs_proto
