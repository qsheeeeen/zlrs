config ZLRS_PROTO
	bool "Protocol core (framing, FHSS sequence, reassembly, CRC)"
	select PSA_CRYPTO
	select PSA_WANT_ALG_HKDF
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_KEY_TYPE_DERIVE
	select PSA_WANT_KEY_TYPE_HMAC
	help
	  Pure C, no Zephyr dependency. Protocol crypto uses the RP2350 hardware backend
	  when enabled by the application, otherwise core/proto/crypto_psa.c. The host
	  tests use tests/host/crypto_soft.c. All backends must produce identical bytes.

module = ZLRS_PROTO
module-str = zlrs_proto
source "subsys/logging/Kconfig.template.log_config"
