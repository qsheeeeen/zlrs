config ZLRS_PROTO
	bool "Protocol core (framing, FHSS sequence, reassembly, CRC)"
	select PSA_CRYPTO
	select PSA_WANT_ALG_HKDF
	select PSA_WANT_ALG_HMAC
	select PSA_WANT_ALG_SHA_256
	select PSA_WANT_KEY_TYPE_DERIVE
	select PSA_WANT_KEY_TYPE_HMAC
	help
	  Pure C, no Zephyr dependency. The crypto part depends on the backend: on target it is
	  Zephyr's PSA Crypto (core/proto/crypto_psa.c, which is why the algorithms above are
	  selected). The host tests use a self-contained software implementation instead
	  (tests/host/crypto_soft.c); both must produce identical bytes.

module = ZLRS_PROTO
module-str = zlrs_proto
source "subsys/logging/Kconfig.template.log_config"
