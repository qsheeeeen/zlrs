config ZLRS_PROTO
	bool "zlrs protocol core"
	help
	  Pure C protocol core: frame codec, FHSS sequence, fragmentation
	  reassembly, CRC utility and the SHA-256 based key derivation and
	  tagging used on air. No Zephyr dependency, so it also builds and
	  runs on the host, see tests/host.

module = ZLRS_PROTO
module-str = zlrs_proto
