menu "zlrs usb device"

config ZLRS_USB
	bool "USB device stack (own usbd context, every CDC in devicetree)"
	depends on USB_DEVICE_STACK_NEXT && USBD_CDC_ACM_CLASS
	help
	  Shared by the application and the MCUboot image; only the strings and VID/PID below differ.

	  In the device_next stack a `zephyr,cdc-acm-uart` node only says how many CDCs exist; the
	  image has to build a context, register the classes and call usbd_enable() itself.
	  Zephyr's CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT registers only the first CDC; the rest
	  have no context and NULL-dereference on the first log write. This code registers them all.

if ZLRS_USB

config ZLRS_USB_VID
	hex "USB vendor ID (VID)"
	default 0x2fe3
	help
	  0x2fe3 is the VID Zephyr reserves for its own samples. A product needs its own.

config ZLRS_USB_PID
	hex "USB product ID (PID)"
	default 0x0004

config ZLRS_USB_MANUFACTURER
	string "USB manufacturer string"
	default "zlrs"

config ZLRS_USB_PRODUCT
	string "USB product string"
	default "ZLRS"
	help
	  The update tool finds its ports by name in /dev/serial/by-id: the application is "ZLRS",
	  the bootloader is "ZLRS MCUBOOT" (see scripts/zlrs-update.py).

config ZLRS_USB_MAX_POWER
	int "USB bMaxPower (units of 2 mA)"
	default 125
	range 0 250

endif # ZLRS_USB

endmenu

module = ZLRS_USB
module-str = zlrs_usb
source "subsys/logging/Kconfig.template.log_config"
