menu "zlrs usb device"

config ZLRS_USB
	bool "USB 设备栈（自建 usbd context + devicetree 里的全部 CDC）"
	depends on USB_DEVICE_STACK_NEXT && USBD_CDC_ACM_CLASS
	help
	  应用镜像与 MCUboot 镜像共用这份代码，差别只在下面的字符串与 VID/PID。

	  device_next 栈里 `zephyr,cdc-acm-uart` 节点只表达"要几块 CDC"，设备要自己
	  建 context、注册类、再 usbd_enable()；Zephyr 自带的
	  CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT 只注册第一块 CDC，其余没有 context，
	  第一次写日志就 NULL 解引用。这份代码一次注册 devicetree 里全部 CDC。

if ZLRS_USB

config ZLRS_USB_VID
	hex "USB 厂商 ID（VID）"
	default 0x2fe3
	help
	  0x2fe3 是 Zephyr 项目给自己示例留的 VID。做产品要换成自己的。

config ZLRS_USB_PID
	hex "USB 产品 ID（PID）"
	default 0x0004

config ZLRS_USB_MANUFACTURER
	string "USB 厂商字符串"
	default "zlrs"

config ZLRS_USB_PRODUCT
	string "USB 产品字符串"
	default "ZLRS"
	help
	  升级脚本按 /dev/serial/by-id 里的名字找端口：应用模式是 "ZLRS"，
	  bootloader 模式是 "ZLRS MCUBOOT"（见 scripts/zlrs-update.py）。

config ZLRS_USB_MAX_POWER
	int "USB bMaxPower（单位 2 mA）"
	default 125
	range 0 250

endif # ZLRS_USB

endmenu

module = ZLRS_USB
module-str = zlrs_usb
source "subsys/logging/Kconfig.template.log_config"
