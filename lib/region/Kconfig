config ZLRS_REGION
	bool "地区表（信道计划 / 功率上限 / 占空比）"
	select ZLRS_PROTO
	help
	  各地区的信道计划、功率上限、占空比上限，以及每次发射前过的占空比记账。
	  纯 C，见 tests/host。

module = ZLRS_REGION
module-str = zlrs_region
source "subsys/logging/Kconfig.template.log_config"
